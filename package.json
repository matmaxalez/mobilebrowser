{
  "name": "mobile-emulator-extension",
  "version": "1.1.0",
  "private": true,
  "description": "Chrome extension (Manifest V3) that renders websites as on a mobile device.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "demo": "node scripts/demo-server.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matmaxalez/mobilebrowser.git"
  }
}
