{
  "manifest_version": 3,
  "name": "Mobile Emulator – widok mobilny stron",
  "short_name": "Mobile Emulator",
  "version": "1.0.1",
  "description": "Strony w tej karcie widzą telefon z Androidem lub iPhone'a i pokazują wersję mobilną – bez ramki, w pełnej karcie.",
  "homepage_url": "https://github.com/matmaxalez/mobilebrowser",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mobile Emulator: wyłączony",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/spoof.js",
        "src/lite-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ],
  "permissions": [
    "debugger",
    "declarativeNetRequest",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-emulation": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Włącz / wyłącz widok mobilny w bieżącej karcie"
    }
  }
}
